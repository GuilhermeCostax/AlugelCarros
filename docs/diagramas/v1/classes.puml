@startuml classes
!pragma layout smetana
title Sistema de Aluguel de Carros — Diagrama de Classes (v1)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F5F9FF
  BorderColor #2C5282
}
hide empty members

abstract class Usuario {
  - id : Long
  - login : String
  - senha : String
  - nome : String
  + getPerfil() : Perfil
}

class Cliente {
  - rg : String
  - cpf : String
  - endereco : String
  - profissao : String
  + adicionarRendimento(r : Rendimento) : void
  + removerRendimento(r : Rendimento) : void
  + getRendaTotal() : BigDecimal
}

class Rendimento {
  - id : Long
  - entidadeEmpregadora : String
  - valor : BigDecimal
}

abstract class Agente {
  - cnpj : String
  + avaliar(p : PedidoAluguel, aprovado : boolean, parecer : String) : void
}

class Empresa
class Banco {
  + concederCredito(c : Contrato, valor : BigDecimal, taxaJuros : BigDecimal, parcelas : int) : ContratoCredito
}

class Automovel {
  - id : Long
  - matricula : String
  - ano : int
  - marca : String
  - modelo : String
  - placa : String
  + isDisponivel() : boolean
}

class PedidoAluguel {
  - id : Long
  - dataCriacao : LocalDateTime
  - dataInicio : LocalDate
  - dataFim : LocalDate
  - status : StatusPedido
  - parecer : String
  - dataAvaliacao : LocalDateTime
  + modificar(automovel : Automovel, inicio : LocalDate, fim : LocalDate) : void
  + cancelar() : void
  + aprovar(agente : Agente, parecer : String) : void
  + reprovar(agente : Agente, parecer : String) : void
}

class Contrato {
  - id : Long
  - dataAssinatura : LocalDate
  - valorTotal : BigDecimal
  - tipoProprietario : TipoProprietario
}

class ContratoCredito {
  - id : Long
  - valor : BigDecimal
  - taxaJuros : BigDecimal
  - numeroParcelas : int
  + getValorParcela() : BigDecimal
}

enum StatusPedido {
  PENDENTE
  APROVADO
  REPROVADO
  CONTRATADO
  CANCELADO
}

enum TipoProprietario {
  CLIENTE
  EMPRESA
  BANCO
}

enum Perfil {
  CLIENTE
  EMPRESA
  BANCO
}

Usuario <|-- Cliente
Usuario <|-- Agente
Agente <|-- Empresa
Agente <|-- Banco

Cliente "1" *-- "0..3" Rendimento : possui >
Cliente "1" -- "0..*" PedidoAluguel : realiza >
PedidoAluguel "0..*" --> "1" Automovel : refere-se a >
PedidoAluguel "0..*" --> "0..1" Agente : avaliado por >
PedidoAluguel "1" -- "0..1" Contrato : origina >
Contrato "1" -- "0..1" ContratoCredito : financiado por >
ContratoCredito "0..*" --> "1" Banco : concedido por >
Automovel "0..*" --> "0..1" Usuario : proprietario >

PedidoAluguel ..> StatusPedido
Contrato ..> TipoProprietario
Usuario ..> Perfil
@enduml
