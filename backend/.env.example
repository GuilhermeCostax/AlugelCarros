# Copie este arquivo para .env e preencha com os dados do Supabase.

# Supabase > botão "Connect" > aba "Session pooler"
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Usuário do Session pooler: postgres.<id-do-projeto>
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx

# Senha do banco definida ao criar o projeto
DB_PASSWORD=sua-senha-aqui

# Chave usada para assinar os tokens de login (JWT). Qualquer texto aleatório longo.
JWT_SECRET=troque-por-um-texto-aleatorio-longo

# Tempo de validade do login, em milissegundos (86400000 = 24h)
JWT_EXPIRATION_MS=86400000
